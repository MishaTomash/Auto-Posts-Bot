# Telegram-бот від @BotFather
TELEGRAM_BOT_TOKEN=1234567890:your_bot_token
ADMIN_TELEGRAM_ID=123456789

# MTProto-акаунт для збору постів: https://my.telegram.org -> API development tools
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash
# Згенерувати: node generate_session.js
TELEGRAM_SESSION=

MONGODB_URI=mongodb://localhost:27017/auto-posts-bot
OPENAI_API_KEY=sk-your_key
UNSPLASH_ACCESS_KEY=your_unsplash_key

# Картка для ручної оплати тарифів
MONO_CARD_NUMBER=0000000000000000
